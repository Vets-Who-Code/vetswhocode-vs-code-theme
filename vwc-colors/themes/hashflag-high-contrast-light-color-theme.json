        "foreground": "#1c3a5e"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8e0f26"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.broken"
      ],
