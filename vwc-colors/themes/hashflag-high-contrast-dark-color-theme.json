  "tokenColors": [
    {
      "settings": {
        "foreground": "#ffffff",
        "background": "#000814"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a9c4e0"
      }
