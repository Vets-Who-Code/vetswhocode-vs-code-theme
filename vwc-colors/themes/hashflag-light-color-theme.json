  "semanticTokenColors": {
    "namespace": "#0b6467",
    "class": "#0b6467",
    "interface": {
      "foreground": "#0b6467",
      "fontStyle": "italic"
    },
    "enum": "#0b6467",
    "enumMember": "#8a5300",
    "type": "#0b6467",
    "typeParameter": {
      "foreground": "#0b6467",
      "fontStyle": "italic"
    },
    "struct": "#0b6467",
    "function": "#1358a6",
    "method": "#1358a6",
    "macro": "#8a5300",
    "decorator": "#8a5300",
    "property": "#2b4b73",
    "property.readonly": {
      "foreground": "#2b4b73",
      "fontStyle": "italic"
    },
    "variable": "#14213d",
    "variable.readonly": "#14213d",
    "variable.readonly.defaultLibrary": "#8a5300",
    "variable.declaration": "#14213d",
    "parameter": {
      "foreground": "#2f4a6b",
      "fontStyle": "italic"
    },
    "keyword": "#a81733",
    "string": "#17654a",
    "number": "#8a5300",
    "regexp": "#17654a",
    "operator": "#43566e",
    "comment": {
      "foreground": "#5c6e85",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "fontStyle": "strikethrough"
    },
    "*.defaultLibrary": {
      "foreground": "#0b6467"
    },
    "selfParameter": {
      "foreground": "#a81733",
      "fontStyle": "italic"
    },
    "builtinConstant": "#8a5300"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#14213d",
        "background": "#f8f9fa"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5c6e85"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#14213d"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.function.parameters"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#2f4a6b"
      }
    },
    {
      "scope": [
        "variable.other.object.property",
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2b4b73"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a81733"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.broken"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#b3122f"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#b3122f"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a81733"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#a81733"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "punctuation.section",
        "punctuation.definition.parameters",
        "punctuation.definition.block"
      ],
      "settings": {
        "foreground": "#43566e"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#4a5a72"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function",
        "keyword.other.special-method",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#1358a6"
      }
    },
    {
      "scope": [
        "entity.name.method",
        "meta.method.declaration entity.name.function"
      ],
      "settings": {
        "foreground": "#1358a6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.alias",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#0b6467"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.other.symbol",
        "constant.other.key"
      ],
      "settings": {
        "fontStyle": "normal",
        "foreground": "#17654a"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "#17654a"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "keyword.other.unit",
        "constant.numeric.line-number"
