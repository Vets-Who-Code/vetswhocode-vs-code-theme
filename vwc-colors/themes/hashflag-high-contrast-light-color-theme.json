    },
    "selfParameter": {
      "foreground": "#8e0f26",
      "fontStyle": "italic"
    },
    "builtinConstant": "#6e4200"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#000000",
        "background": "#ffffff"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#3f5169"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "string constant.other.placeholder"
